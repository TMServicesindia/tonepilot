{
  "$schema": "TonePilot design tokens v1 — platform-neutral. SwiftUI: App/Sources/DesignSystem/Tokens.swift (hand-mirrored, checked by a core test). Android: generate a Compose theme from this file.",
  "meta": {
    "version": 1,
    "updated": "2026-11-06 (owner palette: Midnight / Surface / Elevated / Amber)",
    "direction": "A calm instrument companion: restrained dark, one warm accent."
  },
  "color": {
    "canvas": {
      "dark": "#101116",
      "light": "#F4F4F6",
      "role": "Midnight — screen background"
    },
    "surface": {
      "dark": "#1C1E25",
      "light": "#FFFFFF",
      "role": "Grouped content (one level above canvas)"
    },
    "elevated": {
      "dark": "#292C35",
      "light": "#ECECF0",
      "role": "Controls on a surface: chips, segmented track, inputs"
    },
    "border": {
      "dark": "#353843",
      "light": "#D9D9DF",
      "role": "Hairlines around surfaces when needed"
    },
    "divider": {
      "dark": "#2A2D36",
      "light": "#E3E3E8",
      "role": "Row separators"
    },
    "textPrimary": {
      "dark": "#F5F5F7",
      "light": "#111114",
      "role": "Titles, body"
    },
    "textSecondary": {
      "dark": "#A3A3AB",
      "light": "#5C5C66",
      "role": "Metadata, captions (≥ 4.5:1 on surface)"
    },
    "textTertiary": {
      "dark": "#707078",
      "light": "#8C8C96",
      "role": "Placeholders, disabled text"
    },
    "accent": {
      "dark": "#FFAD32",
      "light": "#D9770A",
      "role": "Primary actions, selection, playhead (TonePilot amber)"
    },
    "onAccent": {
      "dark": "#121212",
      "light": "#FFFFFF",
      "role": "Text and icons on accent"
    },
    "accentMuted": {
      "dark": "#FA9E3329",
      "light": "#D9770A1F",
      "role": "Selected background, suggestion tint"
    },
    "success": {
      "dark": "#3DD27A",
      "light": "#1E9E52"
    },
    "warning": {
      "dark": "#FFD24D",
      "light": "#B88400"
    },
    "error": {
      "dark": "#FF5A4F",
      "light": "#D7261B"
    },
    "info": {
      "dark": "#6CC8FF",
      "light": "#0A74C9"
    },
    "disabled": {
      "dark": "#4A4A50",
      "light": "#C2C2C8"
    },
    "section": [
      "#F0A04B",
      "#4FC1B4",
      "#A98BF5",
      "#F07AA8",
      "#E8D25B",
      "#7FD99A",
      "#7E8CF0",
      "#5CC8E8"
    ],
    "part": {
      "vocals": "#F07AA8",
      "music": "#4FC1B4",
      "drums": "#F0A04B",
      "bass": "#A98BF5",
      "lead": "#4FC1B4",
      "backing": "#7FD99A",
      "piano": "#E8D25B",
      "guitar": "#7E8CF0",
      "rule": "Small identity marker only (dot / thin bar). Never a card background, never glowing."
    },
    "highContrast": {
      "textSecondary": "#C9C9D0",
      "border": "#4A4A52"
    },
    "group": {
      "values": [
        "#4FC1B4",
        "#8C7CF0",
        "#E07AA8",
        "#5E5E68"
      ],
      "role": "Song Map / cover repeat groups; current section = accent"
    },
    "accentGradient": {
      "top": "#FFBE55",
      "bottom": "#F59A22",
      "role": "Primary-action fill"
    },
    "accentGlow": {
      "value": "#FFAD32",
      "opacity": 0.3,
      "role": "Soft glow under primary actions"
    },
    "ambient": {
      "violet": "#7C5CFF",
      "violetOpacity": 0.13,
      "warm": "#FFAD32",
      "warmOpacity": 0.07,
      "role": "Faint screen light: violet top-right, warm bottom-left"
    },
    "family": {
      "strings": [
        "#6A3C1C",
        "#241309",
        "#FFB866"
      ],
      "winds": [
        "#1C5A54",
        "#0C1F1D",
        "#6FE0D2"
      ],
      "keys": [
        "#34397A",
        "#121330",
        "#A9B2FF"
      ],
      "plucked": [
        "#68244A",
        "#220B18",
        "#FF9CC8"
      ],
      "percussion": [
        "#6A4416",
        "#231606",
        "#FFD27A"
      ],
      "voice": [
        "#642656",
        "#210B1C",
        "#FF9BD9"
      ],
      "bass": [
        "#43317A",
        "#16102C",
        "#C7B1FF"
      ],
      "synth": [
        "#1F466A",
        "#0A1724",
        "#7FD0FF"
      ],
      "brass": [
        "#62521A",
        "#221C08",
        "#FFE36E"
      ],
      "role": "Instrument tile radial gradient [light, dark, ink]"
    }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24,
    "xxl": 32,
    "screenMargin": 16,
    "sectionGap": 24,
    "componentPadding": 16,
    "inline": 8
  },
  "radius": {
    "s": 8,
    "m": 12,
    "l": 16,
    "full": 999
  },
  "size": {
    "touchTarget": 44,
    "primaryButton": 50,
    "transportPlay": 64,
    "segmentedHeight": 40,
    "artwork": 44
  },
  "type": {
    "note": "Roles map to platform text styles so Dynamic Type / font scale apply. Never fixed sizes for text.",
    "largeTitle": {
      "ios": "largeTitle/bold",
      "android": "headlineLarge"
    },
    "screenTitle": {
      "ios": "title2/bold",
      "android": "headlineSmall"
    },
    "section": {
      "ios": "headline",
      "android": "titleMedium"
    },
    "subsection": {
      "ios": "subheadline/semibold",
      "android": "titleSmall"
    },
    "body": {
      "ios": "body",
      "android": "bodyLarge"
    },
    "bodySecondary": {
      "ios": "subheadline",
      "android": "bodyMedium"
    },
    "label": {
      "ios": "subheadline/semibold",
      "android": "labelLarge"
    },
    "caption": {
      "ios": "footnote",
      "android": "bodySmall"
    },
    "metadata": {
      "ios": "caption",
      "android": "labelSmall"
    },
    "button": {
      "ios": "headline",
      "android": "labelLarge"
    },
    "numeric": {
      "ios": "body/monospacedDigit",
      "android": "bodyLarge + tnum"
    },
    "display": {
      "ios": "title/bold/rounded",
      "android": "displaySmall"
    }
  },
  "elevation": {
    "note": "Surfaces are separated by colour, not shadow. Only floating bars use a material.",
    "floatingBar": "ultraThinMaterial / surface 92%"
  },
  "motion": {
    "quick": 0.15,
    "standard": 0.25,
    "note": "Reduce Motion: cross-fade instead of slide; no motion during playback-critical updates."
  }
}