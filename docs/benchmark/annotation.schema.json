{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "TonePilot song ground-truth annotation",
 "type": "object",
 "required": ["song_id", "language", "audio_sha256", "annotator", "verification", "events"],
 "properties": {
  "song_id": {"type": "string", "pattern": "^(ta|te|hi)-[0-9]{4,}$"},
  "language": {"enum": ["ta", "te", "hi"]},
  "audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "annotator": {"type": "string"},
  "verification": {"enum": ["verified", "partial", "unverified"]},
  "sections": {"type": "array", "items": {"type": "object", "required": ["id", "type", "start", "end"],
    "properties": {"id": {"type": "string"}, "type": {"enum": ["intro", "verse", "pallavi", "charanam", "chorus", "interlude", "bridge", "outro", "background", "other"]},
                   "start": {"type": "number"}, "end": {"type": "number"}}}},
  "events": {"type": "array", "items": {"type": "object",
    "required": ["start", "end", "label", "level", "family", "source", "audibility", "confidence"],
    "properties": {"section": {"type": "string"}, "start": {"type": "number"}, "end": {"type": "number"},
      "label": {"type": "string"}, "level": {"enum": ["instrument", "family"]}, "family": {"type": "string"},
      "source": {"enum": ["acoustic", "electronic", "imitation", "unknown"]},
      "audibility": {"enum": ["clear", "partial", "uncertain"]}, "overlaps": {"type": "array", "items": {"type": "string"}},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence": {"type": "string"},
      "verified": {"type": "boolean"}}}}
 }
}
